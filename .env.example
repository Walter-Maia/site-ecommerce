# Copie para .env.local (nunca versionado). `npm run db:seed` gera os segredos
# que faltarem automaticamente em .env.local.

# Segredo do servidor (>= 32 caracteres aleatórios). Usado para pseudonimizar
# IPs (HMAC) em login_attempts/audit_log. Obrigatório em produção.
SESSION_SECRET=

# Senha do usuário admin@kimkriss.test criado pelo seed. Gerada aleatoriamente;
# troque com `npm run db:seed -- --reset-admin-password`.
ADMIN_SEED_PASSWORD=

# Opcional: caminho do banco SQLite (padrão: data/kimkriss.db). ":memory:" nos testes.
# KIMKRISS_DB_PATH=

# Produção: de onde vem o IP real do cliente para o rate limit (escolha UM).
# Sem isso o IP é forjável via X-Forwarded-For.
# TRUSTED_IP_HEADER=cf-connecting-ip        # Cloudflare | x-vercel-forwarded-for | x-real-ip (nginx com $remote_addr)
# TRUSTED_PROXY_HOPS=1                       # nº de proxies confiáveis que anexam ao X-Forwarded-For

# URL pública do site (canonical, Open Graph, JSON-LD).
# NEXT_PUBLIC_SITE_URL=https://kimkriss.example

# Produção com várias instâncias: chave estável das Server Actions.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
